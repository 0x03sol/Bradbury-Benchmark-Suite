# Bradbury Benchmark Suite — Environment Configuration (template)
# Copy to .env and fill in PRIVATE_KEY before running.
# Network: GenLayer Bradbury Testnet (Chain ID 4221, symbol GEN)

GENLAYER_RPC_URL=https://zksync-os-testnet-genlayer.zksync.dev
GENLAYER_CHAIN_ID=4221
GENLAYER_SYMBOL=GEN

# Explorer APIs
EXPLORER_ZKSYNC=https://zksync-os-testnet-genlayer.explorer.zksync.dev
EXPLORER_BRADBURY=http://explorer-bradbury.genlayer.com

# Faucet
FAUCET_URL=https://testnet-faucet.genlayer.foundation

# Benchmark configuration
BENCHMARK_ITERATIONS=5
VALIDATOR_COUNTS=3,5,7,11
DEFAULT_TIMEOUT_SECONDS=300

# Model configurations (informational tag only)
MODELS=openai/gpt-4,anthropic/claude-3-opus,meta/llama-3-70b

# Data & reporting
DATA_DIR=./data
REPORTS_DIR=./reports

# API server
# PORT is set by the platform (Railway/Heroku); locally falls back to API_PORT.
API_PORT=8000
# Comma-separated allowlist of frontend origins permitted to call the API.
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:5173

# Logging
LOG_LEVEL=INFO

# REQUIRED: testnet wallet private key (0x-prefixed, fund via faucet above).
# NEVER commit a real key. Use a fresh testnet-only address.
PRIVATE_KEY=0xYOUR_TESTNET_PRIVATE_KEY_HERE
